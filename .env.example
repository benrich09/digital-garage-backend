# Copy this file to .env and fill in real values. Never commit .env itself
# (it's in .gitignore) — these are placeholders only.

# --- Supabase --------------------------------------------------------
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only).
# Get this from Supabase Dashboard -> Project Settings -> Database.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Project Settings -> API -> service_role key. Server-side only, never
# ship this to a mobile app or the admin dashboard's client bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Project Settings -> API -> JWT Secret. Used to verify access tokens
# issued to the mobile apps / admin dashboard without a round-trip to Supabase.
SUPABASE_JWT_SECRET=xxx

# --- M-Pesa (Safaricom/Vodacom Daraja, Lipa Na M-Pesa Online / STK Push) ---
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=your_paybill_or_till_shortcode
MPESA_PASSKEY=your_daraja_passkey
# sandbox: https://sandbox.safaricom.co.ke  |  production: https://api.safaricom.co.ke
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# Must be a public HTTPS URL Daraja can reach, e.g. https://api.yourdomain.com/webhooks/mpesa?secret=...
MPESA_CALLBACK_URL=https://your-domain.example.com/webhooks/mpesa?secret=CHANGE_ME
# Shared secret you invent yourself and append as ?secret= on MPESA_CALLBACK_URL above.
MPESA_CALLBACK_SECRET=CHANGE_ME

# --- Selcom -----------------------------------------------------------
SELCOM_VENDOR_ID=your_selcom_vendor_id
SELCOM_API_KEY=your_selcom_api_key
SELCOM_API_SECRET=your_selcom_api_secret
# sandbox: https://apigwtest.selcommobile.com  |  production: https://apigw.selcommobile.com
SELCOM_BASE_URL=https://apigwtest.selcommobile.com

# --- Firebase Cloud Messaging (push notifications, optional) ---------
# Leave both blank to run with push notifications disabled.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=

# --- Server ------------------------------------------------------------
PORT=8080
ENV=development
LOG_LEVEL=info
DB_MAX_CONNS=4
DB_MIN_CONNS=1
SHUTDOWN_TIMEOUT_SECONDS=15
